[Unit]
Description=TrueNAS Proxmox Plugin Session Broker
Documentation=https://github.com/truenas/truenas-proxmox-plugin
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/sbin/truenas-plugin-broker --foreground
Restart=on-failure
RestartSec=2
RuntimeDirectory=truenas-plugin
RuntimeDirectoryMode=0700
# Keep /run/truenas-plugin across service restarts so the preflight-alloc
# cache stamps written by pvedaemon workers survive broker upgrades.
# Tmpfs is still wiped on reboot, which is the correct invalidation
# surface for cached TN health signals.
RuntimeDirectoryPreserve=yes
StandardOutput=journal
StandardError=journal
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
